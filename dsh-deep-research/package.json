{
  "name": "@dsh-external/dsh-deep-research",
  "description": "Deep Research orchestrator extension for DeepSeek Harness: an adaptive cybernetics/information-theory deep_research tool on the official workflow engine, reusing built-in web_search/web_fetch.",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./lib/types/index.js",
  "types": "./lib/types/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "src",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b --pretty false"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-workflow": ">=0.2.0-0 <0.3.0",
    "cordis": "^4.0.0-rc.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
